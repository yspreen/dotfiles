#!/bin/bash

real_git=/run/current-system/sw/bin/git
[[ -x "$real_git" ]] || real_git=/usr/bin/git

git_prefix=()
subcommand=
subcommand_args=()
forward_args=()
expect_global_value=false
user_asked_for_it=false

for arg in "$@"; do
  if [[ "$arg" == --user-asked-for-it ]]; then
    user_asked_for_it=true
  else
    forward_args+=("$arg")
  fi
done

for arg in "${forward_args[@]}"; do
  if [[ -n "$subcommand" ]]; then
    subcommand_args+=("$arg")
    continue
  fi

  if [[ "$expect_global_value" == true ]]; then
    git_prefix+=("$arg")
    expect_global_value=false
    continue
  fi

  case "$arg" in
    -C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env)
      git_prefix+=("$arg")
      expect_global_value=true
      ;;
    -C*|-c*|--git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--config-env=*|--exec-path=*|--paginate|--no-pager|--no-replace-objects|--bare|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--no-optional-locks|--no-advice)
      git_prefix+=("$arg")
      ;;
    --*)
      git_prefix+=("$arg")
      ;;
    -*)
      git_prefix+=("$arg")
      ;;
    *)
      subcommand="$arg"
      ;;
  esac
done

creates_branch=false
case "$subcommand" in
  branch)
    branch_mode=create
    for arg in "${subcommand_args[@]}"; do
      case "$arg" in
        -d|-D|--delete|-m|-M|--move|-c|-C|--copy|-l|--list|-a|--all|-r|--remotes|--show-current|--edit-description|-u|--set-upstream-to|--set-upstream-to=*|--unset-upstream|--contains|--contains=*|--no-contains|--no-contains=*|--merged|--merged=*|--no-merged|--no-merged=*|--points-at|--points-at=*|--format|--format=*|--sort|--sort=*)
          branch_mode=other
          ;;
        --)
          ;;
        -*)
          ;;
        *)
          if [[ "$branch_mode" == create ]]; then
            creates_branch=true
          fi
          break
          ;;
      esac
    done
    ;;
  checkout)
    for arg in "${subcommand_args[@]}"; do
      case "$arg" in
        -b|-B|--orphan|--orphan=*) creates_branch=true ;;
      esac
    done
    ;;
  switch)
    for arg in "${subcommand_args[@]}"; do
      case "$arg" in
        -c|-C|--create|--create=*|--force-create|--force-create=*) creates_branch=true ;;
      esac
    done
    ;;
  worktree)
    if [[ "${subcommand_args[0]}" == add ]]; then
      for arg in "${subcommand_args[@]:1}"; do
        case "$arg" in
          -b|-B) creates_branch=true ;;
        esac
      done
    fi
    ;;
esac

if [[ "$creates_branch" == true && "$user_asked_for_it" != true ]]; then
  echo "Please don't create a new branch until the user explicitly asks for it. If they did, retry with --user-asked-for-it." >&2
  exit 1
fi

"$real_git" "${forward_args[@]}"
git_status=$?

if (( git_status == 0 )) && [[ "$subcommand" == commit ]]; then
  message_file="$(mktemp "${TMPDIR:-/tmp}/git-message.XXXXXX")" || exit "$git_status"
  cleaned_file="$(mktemp "${TMPDIR:-/tmp}/git-message-cleaned.XXXXXX")" || {
    rm -f "$message_file"
    exit "$git_status"
  }
  trap 'rm -f "$message_file" "$cleaned_file"' EXIT HUP INT TERM

  "$real_git" "${git_prefix[@]}" log -1 --format=%B > "$message_file"
  if grep -Eq '^Co-Authored-By: .*@anthropic\.com>$' "$message_file"; then
    sed '/^Co-Authored-By: .*@anthropic\.com>$/d' "$message_file" > "$cleaned_file"
    "$real_git" "${git_prefix[@]}" commit --amend --quiet --no-verify --no-post-rewrite -F "$cleaned_file"
    git_status=$?
  fi
fi

exit "$git_status"
