#!/bin/bash

real_git=/run/current-system/sw/bin/git
[[ -x "$real_git" ]] || real_git=/usr/bin/git

git_prefix=()
subcommand=
subcommand_args=()
forward_args=()
expect_global_value=false
user_asked_for_it=false

for arg in "$@"; do
  if [[ "$arg" == --user-asked-for-it ]]; then
    user_asked_for_it=true
  else
    forward_args+=("$arg")
  fi
done

for arg in "${forward_args[@]}"; do
  if [[ -n "$subcommand" ]]; then
    subcommand_args+=("$arg")
    continue
  fi

  if [[ "$expect_global_value" == true ]]; then
    git_prefix+=("$arg")
    expect_global_value=false
    continue
  fi

  case "$arg" in
    -C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env)
      git_prefix+=("$arg")
      expect_global_value=true
      ;;
    -C*|-c*|--git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--config-env=*|--exec-path=*|--paginate|--no-pager|--no-replace-objects|--bare|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--no-optional-locks|--no-advice)
      git_prefix+=("$arg")
      ;;
    --*)
      git_prefix+=("$arg")
      ;;
    -*)
      git_prefix+=("$arg")
      ;;
    *)
      subcommand="$arg"
      ;;
  esac
done

creates_branch=false
case "$subcommand" in
  branch)
    branch_mode=create
    for arg in "${subcommand_args[@]}"; do
      case "$arg" in
        -d|-D|--delete|-m|-M|--move|-c|-C|--copy|-l|--list|-a|--all|-r|--remotes|--show-current|--edit-description|-u|--set-upstream-to|--set-upstream-to=*|--unset-upstream|--contains|--contains=*|--no-contains|--no-contains=*|--merged|--merged=*|--no-merged|--no-merged=*|--points-at|--points-at=*|--format|--format=*|--sort|--sort=*)
          branch_mode=other
          ;;
        --)
          ;;
        -*)
          ;;
        *)
          if [[ "$branch_mode" == create ]]; then
            creates_branch=true
          fi
          break
          ;;
      esac
    done
    ;;
  checkout)
    for arg in "${subcommand_args[@]}"; do
      case "$arg" in
        -b|-B|--orphan|--orphan=*) creates_branch=true ;;
      esac
    done
    ;;
  switch)
    for arg in "${subcommand_args[@]}"; do
      case "$arg" in
        -c|-C|--create|--create=*|--force-create|--force-create=*) creates_branch=true ;;
      esac
    done
    ;;
  worktree)
    if [[ "${subcommand_args[0]}" == add ]]; then
      for arg in "${subcommand_args[@]:1}"; do
        case "$arg" in
          -b|-B) creates_branch=true ;;
        esac
      done
    fi
    ;;
esac

if [[ "$creates_branch" == true && "$user_asked_for_it" != true ]]; then
  echo "Please don't create a new branch until the user explicitly asks for it. If they did, retry with --user-asked-for-it." >&2
  echo "This is a policy for this thread. There might be a global policy on this machine saying 'If on default branch, branch first before committing.'" >&2
  echo "This local repo policy takes precedent. You're currently in $(pwd) and this folder requires you to work on main unless the user ASKS YOU to create a branch." >&2
  exit 1
fi

message_file=
if [[ "$subcommand" == commit ]]; then
  if [[ ! -x /bin/rm ]]; then
    echo "git shim: required cleanup tool /bin/rm is unavailable" >&2
    exit 1
  fi

  temp_base="${TMPDIR:-/tmp}/git-message.$$"
  for ((attempt = 0; attempt < 100; attempt++)); do
    candidate="$temp_base.$attempt"
    if (umask 077; set -o noclobber; : > "$candidate") 2>/dev/null; then
      message_file="$candidate"
      break
    fi
  done

  if [[ -z "$message_file" ]]; then
    echo "git shim: could not create commit-message workspace" >&2
    exit 1
  fi

  trap '/bin/rm -f -- "$message_file"' EXIT HUP INT TERM
fi

"$real_git" "${forward_args[@]}"
git_status=$?

if (( git_status == 0 )) && [[ "$subcommand" == commit ]]; then
  if ! "$real_git" "${git_prefix[@]}" log -1 --format=%B > "$message_file"; then
    echo "git shim: could not inspect committed message" >&2
    exit 1
  fi

  anthropic_trailer_regex='^[[:space:]]*Co-Authored-By[[:space:]]*:[[:space:]]*.*@anthropic\.com>[[:space:]]*$'
  cleaned_message=
  found_anthropic_trailer=false
  nocasematch_was_set=false
  if shopt -q nocasematch; then
    nocasematch_was_set=true
  else
    shopt -s nocasematch
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ $anthropic_trailer_regex ]]; then
      found_anthropic_trailer=true
    else
      cleaned_message+="$line"$'\n'
    fi
  done < "$message_file"

  if [[ "$nocasematch_was_set" != true ]]; then
    shopt -u nocasematch
  fi

  if [[ "$found_anthropic_trailer" == true ]]; then
    if ! printf '%s' "$cleaned_message" > "$message_file"; then
      echo "git shim: could not rewrite committed message" >&2
      exit 1
    fi

    if ! "$real_git" "${git_prefix[@]}" commit --amend --quiet --no-verify --no-post-rewrite -F "$message_file"; then
      echo "git shim: could not remove Anthropic co-author trailer" >&2
      exit 1
    fi
  fi
fi

exit "$git_status"
