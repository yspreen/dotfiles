{
  "env": {
    "COMPUTER_USE_CODEX_LAUNCHER_PATH": "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex"
  },
  "permissions": {
    "defaultMode": "dontAsk"
  },
  "model": "opus[1m]",
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "claude-codex-computer-use@songkeys": true,
    "dev-browser@dev-browser-marketplace": false
  },
  "extraKnownMarketplaces": {
    "songkeys": {
      "source": {
        "source": "github",
        "repo": "songkeys/claude-codex-computer-use"
      }
    },
    "dev-browser-marketplace": {
      "source": {
        "source": "github",
        "repo": "sawyerhood/dev-browser"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "grok-4.7(low)": {
      "effortLevel": "low"
    },
    "claude-haiku-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-daltonized",
  "fileCheckpointingEnabled": false,
  "voiceEnabled": true,
  "switchModelsOnFlag": false
}
